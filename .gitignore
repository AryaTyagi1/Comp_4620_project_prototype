```gitignore
# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---------- Node / JS ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
coverage/
.env
.env.local
.env.*.local

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------- Logs / Misc ----------
*.log
*.tmp
.cache/

# ---------- Secrets ----------
# Never commit API keys, credentials, or personal config
config/secrets.json
*.pem
*.key

# Local configuration
config.js
